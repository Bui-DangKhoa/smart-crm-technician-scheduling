<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="zV6LyxoZQR-nJCnv_FEM">
    <mxGraphModel dx="1363" dy="746" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;```plantuml\n@startuml\n\n&#39; ==============================\n&#39; CẤU HÌNH CHUNG\n&#39; ==============================\nskinparam defaultFontName \&quot;DejaVu Sans\&quot;\nskinparam defaultFontSize 12\nskinparam packageStyle rectangle\n\ntop to bottom direction\n\n&#39; Khoảng cách giữa các thành phần\nskinparam nodesep 60\nskinparam ranksep 90\n\n&#39; Kích thước component\nskinparam component {\n    MinimumWidth 150\n    MinimumHeight 45\n}\n\n&#39; ==============================\n&#39; TIÊU ĐỀ\n&#39; ==============================\ntitle SƠ ĐỒ KIẾN TRÚC PHÂN LỚP (LAYERED ARCHITECTURE) - LUỒNG L4 (TRACK SE)\n\n\n&#39; ==============================\n&#39; 1. PRESENTATION LAYER\n&#39; ==============================\npackage \&quot;1. LỚP TRÌNH BÀY (Presentation Layer)\&quot; {\n\n    [TicketListController] as TLC\n    [AssignmentController] as AC\n    [AppointmentController] as APC\n\n    TLC -[hidden]- AC\n    AC -[hidden]- APC\n}\n\nnote right of TLC\nTrách nhiệm:\n- Nhận Request\n- Kiểm tra định dạng đầu vào đơn giản\n- Trả về Response UI/JSON\n- KHÔNG chứa logic nghiệp vụ\n- KHÔNG truy cập CSDL\nend note\n\n\n&#39; ==============================\n&#39; 2. BUSINESS / SERVICE LAYER\n&#39; ==============================\npackage \&quot;2. LỚP NGHIỆP VỤ (Business / Service Layer)\&quot; {\n\n    [TicketAssignmentService] as TAS\n}\n\nnote right of TAS\nTrách nhiệm:\n- Chứa TOÀN BỘ quy tắc nghiệp vụ\n- SLA QT-04\n- Đổi KTV QT-07\n- Tay nghề &gt;= 3 QT-08\n- Chống trùng lịch hẹn\nend note\n\n\n&#39; ==============================\n&#39; 3. DATA ACCESS / REPOSITORY\n&#39; ==============================\npackage \&quot;3. LỚP TRUY CẬP DỮ LIỆU (Data Access / Repository Layer)\&quot; {\n\n    [TicketRepository] as TR\n    [TechnicianRepository] as TechR\n    [AppointmentRepository] as AR\n\n    TR -[hidden]- TechR\n    TechR -[hidden]- AR\n}\n\nnote right of TR\nTrách nhiệm:\n- Đọc / ghi CSDL\n- Che giấu chi tiết công nghệ lưu trữ\n- Thực hiện SQL / ORM\nend note\n\n\n&#39; ==============================\n&#39; 4. DATA STORE\n&#39; ==============================\npackage \&quot;4. LỚP LƯU TRỮ (Data Store Layer - PostgreSQL)\&quot; {\n\n    database \&quot;ticket\&quot; as DB_Ticket\n    database \&quot;technician\&quot; as DB_Tech\n    database \&quot;technician_skill\&quot; as DB_Skill\n    database \&quot;appointment\&quot; as DB_App\n    database \&quot;ticket_status_log\&quot; as DB_Log\n\n    DB_Ticket -[hidden]- DB_Tech\n    DB_Tech -[hidden]- DB_Skill\n    DB_Skill -[hidden]- DB_App\n    DB_App -[hidden]- DB_Log\n}\n\n\n&#39; ==============================\n&#39; DEPENDENCY FLOW\n&#39; ==============================\n\n&#39; Presentation → Business\nTLC --&gt; TAS : HTTP + JSON / DTO\nAC --&gt; TAS\nAPC --&gt; TAS\n\n&#39; Business → Repository\nTAS --&gt; TR : Interface Call\nTAS --&gt; TechR\nTAS --&gt; AR\n\n&#39; Repository → Data Store\nTR --&gt; DB_Ticket : SQL / ORM\nTR --&gt; DB_Log\n\nTechR --&gt; DB_Tech : SQL / ORM\nTechR --&gt; DB_Skill\n\nAR --&gt; DB_App : SQL / ORM\n\n\n&#39; ==============================\n&#39; NGOÀI PHẠM VI\n&#39; ==============================\n\nnote bottom of DB_App\n\n&lt;b&gt;NGOÀI PHẠM VI (WON&#39;T)&lt;/b&gt;\n\nKhông dùng:\n- Message Queue (Kafka / RabbitMQ)\n- Redis Cache\n- Tổng đài VoIP\n- SMS tự động\n\nend note\n\n\n&#39; ==============================\n&#39; LEGEND\n&#39; ==============================\n\nlegend right\n|= Ký hiệu |= Ý nghĩa |\n| Rectangle | Lớp / Component / Class |\n| Database | Cơ sở dữ liệu quan hệ |\n| Mũi tên | Hướng phụ thuộc 1 chiều (Top-down) |\nendlegend\n\n@enduml\n```&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9DekCi_ALthOXZYBpv7F-88">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
